# Copy to .env and fill in. Never commit .env. See docs/runbooks/m1-accounts.md

# Model providers (production)
GEMINI_API_KEY=
GROQ_API_KEY=
# Model providers (evals only, so tests never use production quota - docs/10-ops-and-costs.md, section 3)
GEMINI_API_KEY_EVALS=
GROQ_API_KEY_EVALS=

# Model ids. Verified in spike S3/S4 before they are fixed in config
GEMINI_MODEL=
GROQ_MODEL=
EMBEDDING_MODEL=

# Database (Neon, eu-central-1). Pooled for the app, direct for migrations
DATABASE_URL=
DATABASE_URL_DIRECT=

# Observability (Langfuse EU)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Email (Resend). CONTACT_EMAIL is never committed or shown in the UI
RESEND_API_KEY=
CONTACT_EMAIL=

# Server secrets. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VISITOR_HMAC_SECRET=
CANARY_TOKEN=

# Kill switch (docs/09-security-privacy.md, section 7)
AGENT_ENABLED=true
