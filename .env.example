# Copy to .env and fill in. Never commit .env. See docs/runbooks/m1-accounts.md

# Model providers (production)
GEMINI_API_KEY=
GROQ_API_KEY=
# Model providers (evals only). Quota may be shared per project/org, so the hard
# evals budget lives in code (docs/10-ops-and-costs.md, section 3)
GEMINI_API_KEY_EVALS=
GROQ_API_KEY_EVALS=
# Embeddings candidates on Cloudflare Workers AI, free plan, no payment method (M3, ADR-0009)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN_EVALS=

# Model ids, in routing order (docs/adr/0005-llm-providers.md). Each one must pass spike S3
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
# The one model that reads a screenshot of a job posting (ADR-0022). Preview on Groq; it is also
# a fallback above, so they share one daily token count.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Screenshots read per visitor per day (docs/09, section 4)
LIMIT_IMAGE_DAY=3
GEMINI_MODEL=gemini-3.6-flash
JUDGE_MODEL=qwen/qwen3.8-27b
# Spike S4 only (M1): Gemini embeddings, not used on the visitor path (ADR-0009)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Production embeddings (ADR-0012): a folder with onnx/model_quantized.onnx and
# tokenizer.json of multilingual-e5-small, checked against pinned SHA-256 hashes
# Fill it with: python -m portfolio_agent.retrieval.fetch_model <dir>
EMBEDDING_MODEL_DIR=

# Database (Neon, eu-central-1). Pooled for the app, direct for migrations
DATABASE_URL=
DATABASE_URL_DIRECT=

# Observability (Langfuse EU)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Email (Resend). CONTACT_EMAIL is never committed or shown in the UI
RESEND_API_KEY=
CONTACT_EMAIL=

# Server secrets. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VISITOR_HMAC_SECRET=
CANARY_TOKEN=

# Limits (docs/09-security-privacy.md, section 4). Empty = the values there.
LIMIT_VISITOR_DAY=
LIMIT_VISITOR_MINUTE=
LIMIT_IP_DAY=
LIMIT_CONVERSATION=
# Tokens per model per day at the provider; visitors get 80% of it, the rest is left for CI
MODEL_DAY_TOKENS=

# Kill switch (docs/09-security-privacy.md, section 7)
AGENT_ENABLED=true
