# Copy to .env and fill in. Never commit .env. See docs/runbooks/m1-accounts.md

# Model providers (production)
GEMINI_API_KEY=
GROQ_API_KEY=
# Model providers (evals only). Quota may be shared per project/org, so the hard
# evals budget lives in code (docs/10-ops-and-costs.md, section 3)
GEMINI_API_KEY_EVALS=
GROQ_API_KEY_EVALS=

# Model ids, in routing order (docs/adr/0005-llm-providers.md). Each one must pass spike S3
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.6-flash
JUDGE_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Database (Neon, eu-central-1). Pooled for the app, direct for migrations
DATABASE_URL=
DATABASE_URL_DIRECT=

# Observability (Langfuse EU)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Email (Resend). CONTACT_EMAIL is never committed or shown in the UI
RESEND_API_KEY=
CONTACT_EMAIL=

# Server secrets. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VISITOR_HMAC_SECRET=
CANARY_TOKEN=

# Kill switch (docs/09-security-privacy.md, section 7)
AGENT_ENABLED=true
